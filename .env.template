# Copy to .env.local and replace placeholders locally. Never commit secrets.
# Next.js, Prisma CLI, and database scripts all load this file consistently.
# PostgreSQL 15+ connection string used by Prisma 8.
DATABASE_URL=

# ID used to scope workspace queries to the configured merchant.
SOKOPILOT_MERCHANT_ID=""
# Shared workspace access code and signing secret.
# Use a random passphrase of at least 12 characters and an independent random
# signing secret of at least 32 characters.
WORKSPACE_ACCESS_CODE=""
WORKSPACE_ACCESS_SECRET=""

# Required when enabling the Meta WhatsApp webhook integration.
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Optional Facebook Login for Business / WhatsApp Embedded Signup v4 config.
# Embedded Signup is disabled when an existing number or fixed-number credentials are configured.
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# 32-byte AES-256 key as 64 hexadecimal characters.
# Required to encrypt WhatsApp access tokens stored by the app.
WHATSAPP_TOKEN_ENCRYPTION_KEY=""
# WABA, phone number, and token are used by the fixed-number connector script.
# If all three are set, Settings greys out Embedded Signup.
META_WABA_ID=""
META_PHONE_NUMBER_ID=""
# Optional display value; the connected record is stored in the database.
META_DISPLAY_PHONE_NUMBER=""
META_ACCESS_TOKEN=""
META_GRAPH_API_VERSION=""
# Explicit opt-in before workspace seed, product, handoff, webhook, or reply writes.
# Enable only after reviewing the configured DATABASE_URL.
SOKOPILOT_DATABASE_WRITES_ENABLED=""

# Server-side Meta Model API settings.
# Assistant activation also requires a connected WhatsApp test number and
# explicit enablement from the protected Settings page. No model fallback is used.
META_MODEL_API_URL=""
META_MODEL_NAME=""
META_MODEL_API_KEY=""
