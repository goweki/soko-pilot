# Copy to .env.local and replace placeholders locally. Never commit secrets.
# Next.js, Prisma CLI, and database scripts all load this file consistently.
# PostgreSQL 15+ connection string used by Prisma 8.
DATABASE_URL=

# ID used to scope all demo queries to the synthetic merchant.
DEMO_MERCHANT_ID=""
# Temporary shared demo gate, not production authentication.
# Use a random passphrase of at least 12 characters and an independent random
# signing secret of at least 32 characters.
DEMO_ACCESS_CODE=""
DEMO_GATE_SECRET=""

# Required when enabling the Meta WhatsApp webhook integration.
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Optional Facebook Login for Business / WhatsApp Embedded Signup v4 config.
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# 32-byte AES-256 key as 64 hexadecimal characters.
WHATSAPP_TOKEN_ENCRYPTION_KEY=""
META_WABA_ID=""
# Optional fixed number used by the legacy environment-based connector script.
# Embedded Signup stores connected number IDs and encrypted tokens in the database.
META_PHONE_NUMBER_ID=""
META_DISPLAY_PHONE_NUMBER=""
META_ACCESS_TOKEN=""
META_GRAPH_API_VERSION=""
# Explicit opt-in before any demo seed, product, handoff, webhook, or reply write.
# Enable only with a reviewed, dedicated demo/development DATABASE_URL.
SOKOPILOT_DEMO_DB_WRITE_APPROVED=""

# Server-side Meta Model API settings. The current pilot uses Muse Wonder.
# Assistant activation also requires a connected WhatsApp test number and
# explicit enablement from the protected Settings page. No model fallback is used.
META_MODEL_API_URL=""
META_MODEL_NAME=""
META_MODEL_API_KEY=""
