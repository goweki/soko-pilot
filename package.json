{
  "name": "soko-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate": "npx prisma contract emit && npx prisma migration plan && npx prisma db migrate --advance-ref db",
    "dev:http": "npx prisma contract emit && next dev",
    "dev": "npx prisma contract emit && next dev --experimental-https",
    "prebuild": "prisma contract emit",
    "build": "next build",
    "db:deploy": "prisma db migrate",
    "docker:build": "docker build -t ghcr.io/goweki/loci:latest .",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma contract emit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "pre-commit": "lint-staged",
    "db:seed": "tsx src/lib/prisma/seed",
    "db:backup": "tsx src/lib/prisma/scripts/backup",
    "db:restore": "tsx src/lib/prisma/scripts/restore -f",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:mirror": "npx tsx src/lib/prisma/scripts/restore_live_to_local",
    "contract:emit": "prisma contract emit",
    "db:seed-demo": "tsx src/lib/prisma/seed.ts",
    "db:connect-demo-whatsapp": "tsx src/lib/prisma/connect-demo-whatsapp.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "^8.0.0-rc.20",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^8.0.0-rc.27",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
